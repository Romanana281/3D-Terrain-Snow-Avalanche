<Window x:Class="Project4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project4"
        mc:Ignorable="d"
        Title="3D Функции" Height="450" Width="800">
    <Window.Background>
        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.MenuHighlightColorKey}}"/>
    </Window.Background>
    <Grid>
        <TabControl 
            BorderThickness="0" 
            BorderBrush="Transparent"
            x:Name="MainTab">
            <TabControl.Background>
                <SolidColorBrush 
                    Color="{DynamicResource {x:Static SystemColors.HotTrackColorKey}}"/>
            </TabControl.Background>

            <TabItem 
                Header="Седло" 
                Background="#FF8CC5AA" 
                BorderBrush="#FF8CC5AA">
                <Grid>
                    <local:Viewer x:Name="Saddle"/>
                    <Grid.Background>
                        <SolidColorBrush 
                            Color="{DynamicResource {x:Static SystemColors.MenuHighlightColorKey}}"/>
                    </Grid.Background>
                </Grid>
            </TabItem>
            <TabItem 
                Header="Параболоид" 
                Background="#FF8CC5AA" 
                BorderBrush="#FF8CC5AA">
                <Grid>
                    <Grid.Background>
                        <SolidColorBrush 
                            Color="{DynamicResource {x:Static SystemColors.MenuHighlightColorKey}}"/>
                    </Grid.Background>
                    <local:Viewer x:Name="Paraboloid"/>

                </Grid>
            </TabItem>

            <TabItem 
                Header="Волны" 
                Background="#FF8CC5AA" 
                BorderBrush="#FF8CC5AA">
                <Grid>
                    <local:Viewer x:Name="Waves"/>
                    <Grid.Background>
                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.MenuHighlightColorKey}}"/>
                    </Grid.Background>
                </Grid>
            </TabItem>

            <TabItem 
                Header="Гауссов холм" 
                Background="#FF8CC5AA" 
                BorderBrush="#FF8CC5AA">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="33*"/>
                        <ColumnDefinition Width="694*"/>
                        <ColumnDefinition Width="69*"/>
                    </Grid.ColumnDefinitions>
                    <local:Viewer x:Name="GaussianHill" Grid.ColumnSpan="3"/>
                    <Grid.Background>
                        <SolidColorBrush 
                            Color="{DynamicResource {x:Static SystemColors.MenuHighlightColorKey}}"/>
                    </Grid.Background>
                </Grid>
            </TabItem>
        </TabControl>
        <Button 
            x:Name="BSnow" 
            Content="Вкл. снег" 
            Background="#FFBD162C" 
            FontFamily="Times New Roman" 
            Foreground="{DynamicResource {x:Static SystemColors.MenuBrushKey}}" 
            Click="TurnSnow_Click" 
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,1,50,0"
            Width="100"
            Height="22" BorderThickness="0,0,0,0"/>
    </Grid>
</Window>
